#!/bin/sh
# DA4Linux launcher — resolves the da4linux Python package from the
# active Python environment and runs the CLI.
# Works with pip installs (system, --user, venv, editable) and the
# development layout. The package is never vendored into share/.

set -e

# Locate a python3 on PATH (no hardcoded interpreter path).
PYTHON=python3
command -v "$PYTHON" >/dev/null 2>&1 || PYTHON=python
if ! command -v "$PYTHON" >/dev/null 2>&1; then
    echo "da4linux: error: no python3 found in PATH" >&2
    exit 1
fi

# DA4LINUX_HOME overrides the module location (see da4linux(1)).
if [ -n "$DA4LINUX_HOME" ]; then
    PYTHONPATH="$DA4LINUX_HOME${PYTHONPATH:+:$PYTHONPATH}"
    export PYTHONPATH
fi

# Resolve the package from the installed Python environment.
if "$PYTHON" -c "import da4linux" >/dev/null 2>&1; then
    exec "$PYTHON" -m da4linux.cli "$@"
fi

# Graceful fallback: explain what is missing instead of crashing.
echo "da4linux: error: Python package 'da4linux' is not importable by '$PYTHON'" >&2
echo "Install it first, e.g.: $PYTHON -m pip install ." >&2
exit 1
